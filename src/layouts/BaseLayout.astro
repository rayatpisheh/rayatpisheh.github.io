---
import '@fontsource-variable/outfit/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import Lightbox from '../components/Lightbox.astro';
import {
  contact,
  meta,
  profile,
  projects,
  skillGroups,
} from '../data/portfolio';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const isNoindex = Boolean(Astro.props.noindex);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rayatpisheh.github.io';
const canonical = isNoindex ? null : new URL(Astro.url.pathname, Astro.site).href;
const photoUrl = new URL(withBase(profile.photo), Astro.site).href;
const sitemapUrl = new URL(withBase('sitemap.xml'), Astro.site).href;

const emailContact = contact.links.find((l) => l.href.startsWith('mailto:'))?.href ?? 'mailto:rayatpisheh.info@gmail.com';
const sameAsLinks = contact.links
  .filter((l) => l.href.startsWith('http'))
  .map((l) => l.href);
if (!sameAsLinks.some((url) => url.includes('github.com'))) {
  sameAsLinks.push('https://github.com/rayatpisheh');
}

const allSkills = Array.from(
  new Set([
    ...skillGroups.flatMap((group) => group.items.map((item) => item.name)),
    'Payment Systems',
    'Financial Gateways',
  ])
);

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: `${profile.name} - Senior Full Stack Developer`,
      description: meta.description,
      inLanguage: 'en-US',
      publisher: {
        '@id': `${siteUrl}/#person`,
      },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}/#webpage`,
      url: `${siteUrl}/`,
      name: title,
      description,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#person`,
      },
      mainEntity: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: profile.name,
      givenName: 'Mohammad',
      familyName: 'Rayat Pisheh',
      jobTitle: profile.title,
      description: profile.summary,
      image: photoUrl,
      url: `${siteUrl}/`,
      email: emailContact,
      sameAs: sameAsLinks,
      knowsAbout: allSkills,
      hasOccupation: {
        '@type': 'Occupation',
        name: profile.title,
        occupationalCategory: '15-1252.00',
        skills: 'C#, ASP.NET Core, .NET, EF Core, Microservices, Payment Systems, SQL Server, System Design',
      },
      workExample: projects.map((p) => ({
        '@type': 'SoftwareApplication',
        name: p.title,
        description: p.description,
        applicationCategory: 'BusinessApplication',
        ...(p.links?.[0]?.href ? { url: p.links[0].href } : {}),
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="google-site-verification" content="d5HnM6JhrjMEFbwgWsTF_Ga281qqcsJw8O1u5W8jbeQ" />

    {isNoindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        {canonical && <link rel="canonical" href={canonical} />}
        <link rel="sitemap" type="application/xml" href={sitemapUrl} />
      </>
    )}

    {/* Open Graph */}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical ?? siteUrl} />
    <meta property="og:image" content={photoUrl} />
    <meta property="og:image:alt" content={profile.name} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="621" />
    <meta property="og:image:height" content="603" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={photoUrl} />
    <meta name="twitter:image:alt" content={profile.name} />

    {/* Theme & Icons */}
    <meta name="theme-color" content="#eef1f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12151c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    {!isNoindex && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
    )}
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <ScrollToTop />
    <Lightbox />
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/projects-expand.ts"></script>
    <script src="../scripts/lightbox.ts"></script>
    <script src="../scripts/scroll-top.ts"></script>
  </body>
</html>
