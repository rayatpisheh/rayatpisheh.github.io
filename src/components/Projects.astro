---
import type { Project } from '../data/portfolio';
import { opensInNewTab, withBase } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-heading">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="projects-heading">Projects</h2>
      <p class="section-lede">Selected platforms spanning payments, bookings, commerce, and operations.</p>
    </div>

    {
      projects.length === 0 ? (
        <p class="prose">Add a project in the content file when you have one to publish.</p>
      ) : (
        <ul class="project-index">
          {projects.map((project, index) => (
            <li class="project-row" data-reveal data-reveal-delay={String((index % 2) + 1)} data-project>
              <button
                type="button"
                class="project-thumb"
                data-lightbox-open
                data-lightbox-src={withBase(encodeURI(project.image))}
                data-lightbox-alt={project.title}
                aria-haspopup="dialog"
                aria-label={`View larger image of ${project.title}`}
              >
                <img
                  src={withBase(encodeURI(project.image))}
                  alt=""
                  width="320"
                  height="240"
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <div class="project-info">
                <div class="project-heading">
                  <h3>{project.title}</h3>
                  {project.placeholder && <span class="flag">Placeholder</span>}
                </div>
                <p class="project-desc" id={`project-desc-${project.id}`}>
                  {project.description}
                </p>
                <p class="project-stack">{project.stack.join(', ')}</p>
                <div class="project-foot">
                  <button
                    type="button"
                    class="project-more"
                    data-project-toggle
                    aria-expanded="false"
                    aria-controls={`project-desc-${project.id}`}
                    hidden
                  >
                    More
                  </button>
                  {project.links?.map((link) => (
                    <a
                      href={link.href}
                      {...(opensInNewTab(link.href)
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      {link.label}
                      {opensInNewTab(link.href) && (
                        <Icon name="solar:square-arrow-right-up-line-duotone" size="0.9rem" />
                      )}
                      {opensInNewTab(link.href) && (
                        <span class="visually-hidden"> (opens in a new tab)</span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
