---
import type { SkillGroup } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="skills-heading">Skills</h2>
      <p class="section-lede">Backend depth first, with architecture and delivery practices that hold up in production.</p>
    </div>
    <div class="skill-bento">
      {
        groups.map((group, index) => (
          <article
            class:list={[
              'skill-cell',
              { 'skill-cell-wide': index === 0, 'skill-cell-accent': index === 3 },
            ]}
            data-reveal
            data-reveal-delay={String((index % 3) + 1)}
          >
            <h3>
              <Icon name={group.icon} size="1.2rem" />
              {group.title}
            </h3>
            <ul class="skill-tags">
              {group.items.map((item) => (
                <li class="skill-tag">
                  {item.icon && <Icon name={item.icon} size="1.05rem" class="skill-tech-icon" />}
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
            {group.note && <p class="skill-note">{group.note}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>
