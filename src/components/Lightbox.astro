---
import Icon from './Icon.astro';
---

<div class="lightbox" data-lightbox hidden>
  <div class="lightbox-backdrop" data-lightbox-close tabindex="-1"></div>
  <div
    class="lightbox-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Project image preview"
    tabindex="-1"
    data-lightbox-panel
  >
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close image preview">
      <Icon name="solar:close-circle-line-duotone" size="1.5rem" />
    </button>
    <img class="lightbox-image" data-lightbox-image alt="" width="1024" height="1024" />
  </div>
</div>
