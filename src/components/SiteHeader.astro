---
import { navigation, profile } from '../data/portfolio';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href={withBase('#about')}>
      <span class="brand-mark" aria-hidden="true">MR</span>
      <span class="brand-text">{profile.name}</span>
    </a>
    <div class="header-actions">
      <ThemeToggle />
      <nav aria-label="Primary">
        <input class="nav-check" id="nav-toggle" type="checkbox" />
        <label class="nav-toggle" for="nav-toggle">
          <Icon name="solar:hamburger-menu-bold-duotone" size="1.15rem" />
          Menu
        </label>
        <ul class="nav-list">
          {
            navigation.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
