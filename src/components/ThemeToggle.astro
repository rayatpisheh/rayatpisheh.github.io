---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" aria-pressed="false">
  <Icon name="solar:sun-bold-duotone" class="theme-icon theme-icon-sun" size="1.15rem" />
  <Icon name="solar:moon-bold-duotone" class="theme-icon theme-icon-moon" size="1.15rem" />
  <span class="visually-hidden">Toggle colour theme</span>
</button>
